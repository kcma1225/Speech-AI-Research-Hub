# Copy to .env, fill required credentials, then run chmod 600 .env. Never commit real values.
# Change these for your deployment: public addresses, ports, and HTTPS.
# HTTPS_ENABLED=true requires valid nginx/certs/fullchain.pem and privkey.pem.
APP_ORIGIN=http://localhost
OVERLEAF_SITE_URL=http://overleaf.localhost
OVERLEAF_URL=http://overleaf.localhost/
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
HTTPS_ENABLED=false
APP_HOSTNAME=localhost
OVERLEAF_HOSTNAME=overleaf.localhost

# Set owner display name. Profile password changes persist across restart.
OWNER_NAME=Owner

# Required private credentials. Never share .env; chmod 600 .env.
# Changing OWNER_PASSWORD at restart resets Owner password and revokes Owner sessions.
# Changing POSTGRES_PASSWORD updates the existing PostgreSQL role on restart.
OWNER_PASSWORD=
POSTGRES_PASSWORD=
AUTH_SECRET=
OVERLEAF_INVITE_SECRET=

# WebAuthn settings for future Passkey support. Match your HTTPS domain when enabled.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Speech-AI Research Hub

# Internal database connection. Usually leave unchanged.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=research_hub
DATABASE_USER=research_hub

# Persistent container directories. Usually leave unchanged.
UPLOAD_DIR=/data/uploads
SLIDES_DIR=/data/slides

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Keep private key secret. Phone push requires HTTPS (localhost exempt).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
