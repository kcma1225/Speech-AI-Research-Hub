# Speech-AI Research Hub v2 configuration. Copy to .env (or run scripts/gen-env.sh), chmod 600, never commit.
# After editing .env: docker compose up -d --build --force-recreate

# --- Public address -----------------------------------------------------------
# Origin browsers use to reach the site; writes from any other Origin are rejected (CSRF).
APP_ORIGIN=http://localhost
APP_HOSTNAME=localhost
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
# true requires nginx/certs/fullchain.pem + privkey.pem covering APP_HOSTNAME and an https:// APP_ORIGIN.
# Keep false when TLS terminates at a proxy/CDN in front of nginx.
HTTPS_ENABLED=false
# Reverse proxy/CDN in front of nginx (IPs or CIDRs, comma-separated): nginx then takes the client IP from
# its X-Forwarded-For, so login rate limits and session IPs are per visitor, not per proxy. Empty = no proxy.
TRUSTED_PROXIES=

# --- Owner account --------------------------------------------------------------
# Changing OWNER_PASSWORD resets the Owner password at next start and signs the Owner out.
OWNER_NAME=Owner
OWNER_PASSWORD=

# --- Secrets (generate each with: openssl rand -base64 32) ---------------------
# PostgreSQL password of the app role; re-applied to the existing role on every db start.
POSTGRES_PASSWORD=
# Password of the least-privilege hub_worker DB role used by the worker; also re-applied on start.
WORKER_DB_PASSWORD=
# Signs slide-viewer tokens (rotating it invalidates open slide viewers; sessions are unaffected).
AUTH_SECRET=
# RustFS (S3) credentials; the backend and worker use the same pair. Access key: openssl rand -hex 12
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hub

# --- Optional -------------------------------------------------------------------
# Aldine collaborative LaTeX editor: `docker compose --profile latex up -d`. Mount it one of two ways
# (leave both empty to disable):
# - LATEX_HOSTNAME: its own hostname (recommended, isolated from the hub); add it to DNS and the certificate.
#   LATEX_ORIGIN=http(s)://<LATEX_HOSTNAME>[:port]
# - LATEX_PATH: a path on the hub origin, e.g. /latex (no extra DNS). Same origin as the hub: an Aldine XSS
#   could act as the signed-in hub user (accepted risk, docs/aldine-evaluation.md). LATEX_ORIGIN=<APP_ORIGIN>/latex
# Account creation requires Basic Auth user "owner" + LATEX_REGISTER_PASSWORD.
LATEX_HOSTNAME=
LATEX_PATH=
LATEX_ORIGIN=
LATEX_REGISTER_PASSWORD=
# Comma-separated emails that are Aldine admins. With hub SSO, a hub user's Aldine email is the synthetic
# <hub user id>@users.speech-ai-hub.invalid (e.g. the Owner's id from the admin page).
LATEX_ADMIN_EMAILS=
# Sign in to Aldine with hub accounts (the hub backend is the OIDC provider). Set all of:
#   LATEX_OIDC_ISSUER=<APP_ORIGIN>/api/oidc   (must be reachable over https from the latex-app container)
#   LATEX_OIDC_CLIENT_ID (any short name, e.g. aldine) and LATEX_OIDC_CLIENT_SECRET (>= 32 chars; gen-env.sh makes one)
# Redirect URI allowed by the hub: <LATEX_ORIGIN>/api/auth/oauth/oidc/callback, or LATEX_OIDC_REDIRECT_URIS (comma-separated).
# LATEX_SSO_ONLY=1 disables Aldine's own password login/registration once SSO works.
LATEX_OIDC_ISSUER=
LATEX_OIDC_CLIENT_ID=
LATEX_OIDC_CLIENT_SECRET=
LATEX_OIDC_REDIRECT_URIS=
LATEX_OIDC_LABEL=Speech-AI Hub
LATEX_SSO_ONLY=
# Web Push (VAPID). Generate: npx web-push generate-vapid-keys. Phone push needs HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WebAuthn (Passkey, not yet implemented). RP ID must equal the production hostname.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Speech-AI Research Hub
# Slide renders / media transcodes processed in parallel by the worker.
WORKER_CONCURRENCY=1
LOG_LEVEL=info
