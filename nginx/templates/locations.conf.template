    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Strict limit only where passwords/tokens are checked; /api/auth/me runs on every page load.
    location = /api/auth/login {
        limit_req zone=auth_limit burst=5 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }
    location = /api/join {
        limit_req zone=auth_limit burst=5 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }
    location = /api/oidc/token {
        limit_req zone=oidc_limit burst=20 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }
    # Real-time collaboration WebSocket (Yjs). The backend checks Origin and the session cookie itself.
    location = /api/collab {
        limit_req zone=api_limit burst=50 nodelay;
        include /etc/nginx/snippets/proxy-websocket.conf;
    }
    # Live captions while recording a meeting (WebSocket: PCM16 up, captions down). The backend checks Origin and session.
    location ~ ^/api/meetings/[0-9a-f-]+/live$ {
        limit_req zone=api_limit burst=20 nodelay;
        include /etc/nginx/snippets/proxy-websocket.conf;
    }
    # Streaming responses (SSE): AI status/chat/agent runs and the note editor's AI actions.
    location /api/ai/ {
        limit_req zone=api_limit burst=200 nodelay;
        include /etc/nginx/snippets/proxy-sse.conf;
    }
    location /api/agent/ {
        limit_req zone=api_limit burst=200 nodelay;
        include /etc/nginx/snippets/proxy-sse.conf;
    }
    location ~ ^/api/notes/[0-9a-f-]+/ai/ {
        limit_req zone=api_limit burst=50 nodelay;
        include /etc/nginx/snippets/proxy-sse.conf;
    }
    location /api/ {
        limit_req zone=api_limit burst=200 nodelay;
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    root /usr/share/nginx/html;

    # Content-hashed build output: cache forever.
    location /_app/immutable/ {
        include /etc/nginx/conf.d/spa-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/spa-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
