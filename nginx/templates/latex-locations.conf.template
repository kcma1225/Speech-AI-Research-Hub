# Aldine (collaborative LaTeX) on its own hostname (LATEX_HOSTNAME): isolated from the hub origin, so its
# scripts cannot call the hub API with the hub session. LATEX_PATH mode trades that away; see docs/aldine-evaluation.md.
# Project ZIP import accepts up to ~81 MB (base64 of a 60 MB ZIP).
client_max_body_size 81m;
# Resolve at request time so nginx still starts when the `latex` profile is not running (502 instead).
resolver 127.0.0.11 valid=30s ipv6=off;
set $latex_upstream http://latex-app:3000;

# Aldine has no invite-only mode: account creation needs the LATEX_REGISTER_PASSWORD Basic Auth.
location = /api/auth/register {
    auth_basic "Speech-AI Hub LaTeX: account creation";
    auth_basic_user_file /etc/nginx/conf.d/latex-register.htpasswd;
    limit_req zone=auth_limit burst=5 nodelay;
    proxy_pass $latex_upstream;
    include /etc/nginx/snippets/latex-proxy.conf;
}
location = /api/auth/login {
    limit_req zone=auth_limit burst=5 nodelay;
    proxy_pass $latex_upstream;
    include /etc/nginx/snippets/latex-proxy.conf;
}
location / {
    proxy_pass $latex_upstream;
    include /etc/nginx/snippets/latex-proxy.conf;
}
